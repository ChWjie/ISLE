# Database: Cloud Studio and local development use the bundled SQLite database.
DATABASE_URL=sqlite:///./law_game.db
MONGODB_URL=
MONGODB_DB=
REDIS_URL=

# Optional vector database
QDRANT_URL=
QDRANT_API_KEY=

# Application security
SECRET_KEY=replace-with-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Optional OpenAI-compatible LLM (required for plan generation and simulation)
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2000

# Optional DeliLegal retrieval
DELILEGAL_BASE_URL=https://openapi.delilegal.com
DELILEGAL_APP_ID=
DELILEGAL_SECRET=
DELILEGAL_CASE_PAGE_SIZE=5
DELILEGAL_LAW_PAGE_SIZE=5
DELILEGAL_LAW_FIELD_NAME=semantic

# App
APP_NAME=智弈法衡法律博弈智能分析平台
APP_VERSION=1.0.0
DEBUG=False

# Comma-separated origins for deployments that do not use the local Vite proxy.
CORS_ORIGINS=http://localhost:5173
